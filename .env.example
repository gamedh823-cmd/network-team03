# Copy to .env and enter the shared Middleware ingest key.
# Existing PowerShell environment variables take precedence over .env.
MIDDLEWARE_INGEST_URL=http://localhost:8000/ingest
MIDDLEWARE_API_KEY=

# MySQL connection (must match your local mysql-server container).
ENGINESQUARE_DB_HOST=127.0.0.1
ENGINESQUARE_DB_PORT=3306
ENGINESQUARE_DB_USER=root
ENGINESQUARE_DB_PASSWORD=change_me_local_mysql_password
ENGINESQUARE_DB_NAME=enginesquare

# Optional: only if API server and web app run on different PCs sharing one DB.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENGINESQUARE_KEY_DELIVERY_SECRET=
